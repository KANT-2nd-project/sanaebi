[Unit]
Description=Reset Sanaebi disposable demo documents

[Service]
Type=oneshot
User=@RUN_USER@
WorkingDirectory=@PROJECT_ROOT@
ExecStart=@UV_BIN@ run --no-sync --env-file @RUNTIME_ENV@ python -m scripts.reset_demo_documents --apply
Restart=no
UMask=0077
TimeoutStartSec=5min
NoNewPrivileges=true
