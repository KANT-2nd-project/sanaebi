{
  "devDependencies": {
    "concurrently": "10.0.6"
  },
  "name": "sanaebi-dev",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev_runtime.mjs",
    "dev:api": "uv run --locked --env-file .env uvicorn app.fastapi_main:app --reload --reload-dir app --reload-dir generation --host 127.0.0.1 --port 8000",
    "dev:web": "npm --prefix web run dev -- --hostname 127.0.0.1 --port 3000",
    "setup:local": "uv run --locked --env-file .env python -m scripts.prepare_local_runtime",
    "check:local": "uv run --locked --env-file .env python -m scripts.local_runtime --check"
  }
}
